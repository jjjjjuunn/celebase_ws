{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LifestyleClaimSeedFile",
  "description": "IMPL-019 — 셀럽 lifestyle claim seed (사람 작성, allowlist URL only). spec.md §3.5.3 / §9.3 7원칙.",
  "type": "object",
  "additionalProperties": false,
  "required": ["claims"],
  "properties": {
    "celebrity_slug": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "선택. 존재 시 celebrities.slug 와 1:1 매칭(db/seeds/data/<slug>.json 필수, 파일명=slug). 생략/null ⇒ 셀럽 없는 웰니스 트렌드 카드 — 파일명 'trend-' prefix 필수."
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/claim" }
    }
  },
  "definitions": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_type",
        "headline",
        "trust_grade",
        "is_health_claim",
        "tags",
        "status",
        "sources"
      ],
      "properties": {
        "claim_type": {
          "type": "string",
          "enum": ["food", "workout", "sleep", "beauty", "brand", "philosophy", "supplement"]
        },
        "headline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280,
          "description": "plain text only — HTML 태그 금지 (§9.3 #1)"
        },
        "body": {
          "type": ["string", "null"],
          "maxLength": 10000
        },
        "trust_grade": {
          "type": "string",
          "enum": ["A", "B", "C", "D", "E"]
        },
        "primary_source_url": {
          "type": ["string", "null"],
          "maxLength": 2048,
          "format": "uri",
          "description": "allowlist 도메인 만 (§9.3 #2)"
        },
        "verified_by": {
          "type": ["string", "null"],
          "maxLength": 100
        },
        "is_health_claim": {
          "type": "boolean",
          "description": "§9.3 #6 — seed 작성자(human)가 명시 지정"
        },
        "disclaimer_key": {
          "type": ["string", "null"],
          "maxLength": 100,
          "description": "trust_grade='D' AND status='published' 일 때 NOT NULL 필수 (§9.3 #5)"
        },
        "base_diet_id_slug": {
          "type": ["string", "null"],
          "description": "선택. base_diets 의 slug (loader 가 id 로 매핑) — IMPL-020 사용"
        },
        "story": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "description": "선택. 카드뉴스 6슬라이드 리치 카피(앱 캐러셀 + SNS 단일 원본). null/생략 ⇒ 앱 템플릿 fallback. 모든 텍스트 plain(HTML 금지) + **bold**/*accent* 인라인 마크업. (IMPL-MOBILE-CLAIM-STORY-SCHEMA-001)",
          "required": ["hook", "what", "catch", "rescaled", "cta"],
          "properties": {
            "hook": {
              "type": "object",
              "additionalProperties": false,
              "required": ["headline", "sub"],
              "properties": {
                "eyebrow": { "type": "string", "maxLength": 80 },
                "headline": { "type": "string", "minLength": 1, "maxLength": 200 },
                "sub": { "type": "string", "maxLength": 400 },
                "swipe": { "type": "string", "maxLength": 40 }
              }
            },
            "what": {
              "type": "object",
              "additionalProperties": false,
              "required": ["headline", "rows"],
              "properties": {
                "eyebrow": { "type": "string", "maxLength": 80 },
                "headline": { "type": "string", "minLength": 1, "maxLength": 200 },
                "rows": { "type": "array", "items": { "type": "string", "maxLength": 400 }, "minItems": 1, "maxItems": 4 },
                "source": { "type": "string", "maxLength": 400 }
              }
            },
            "science": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "required": ["headline", "checks"],
              "properties": {
                "eyebrow": { "type": "string", "maxLength": 80 },
                "headline": { "type": "string", "minLength": 1, "maxLength": 200 },
                "checks": { "type": "array", "items": { "type": "string", "maxLength": 400 }, "maxItems": 4 },
                "caveat": { "type": "string", "maxLength": 400 },
                "source": { "type": "string", "maxLength": 400 }
              }
            },
            "catch": {
              "type": "object",
              "additionalProperties": false,
              "required": ["headline", "body"],
              "properties": {
                "eyebrow": { "type": "string", "maxLength": 80 },
                "headline": { "type": "string", "minLength": 1, "maxLength": 200 },
                "body": { "type": "string", "maxLength": 600 }
              }
            },
            "rescaled": {
              "type": "object",
              "additionalProperties": false,
              "required": ["headline", "profiles"],
              "properties": {
                "eyebrow": { "type": "string", "maxLength": 80 },
                "headline": { "type": "string", "minLength": 1, "maxLength": 200 },
                "profiles": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["who", "what"],
                    "properties": {
                      "who": { "type": "string", "maxLength": 80 },
                      "what": { "type": "string", "maxLength": 400 }
                    }
                  }
                },
                "source": { "type": "string", "maxLength": 400 }
              }
            },
            "cta": {
              "type": "object",
              "additionalProperties": false,
              "required": ["headline", "sub"],
              "properties": {
                "eyebrow": { "type": "string", "maxLength": 80 },
                "headline": { "type": "string", "minLength": 1, "maxLength": 200 },
                "button": { "type": "string", "maxLength": 40 },
                "sub": { "type": "string", "maxLength": 400 },
                "disclaimer": { "type": "string", "maxLength": 800 }
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "maxLength": 50 },
          "uniqueItems": true,
          "maxItems": 20
        },
        "status": {
          "type": "string",
          "enum": ["draft", "published", "archived"]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/source" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "outlet", "is_primary"],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": ["interview", "social_post", "podcast", "book", "article", "press_release", "other"]
        },
        "outlet": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {
          "type": ["string", "null"],
          "maxLength": 2048,
          "format": "uri"
        },
        "published_date": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "excerpt": {
          "type": ["string", "null"],
          "maxLength": 300,
          "description": "fair-use 인용 (plain text only)"
        },
        "is_primary": {
          "type": "boolean"
        }
      }
    }
  }
}
