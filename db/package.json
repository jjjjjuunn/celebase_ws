{
  "name": "@celebbase/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "migrate": "node-pg-migrate up --migrations-dir migrations",
    "migrate:create": "node-pg-migrate create --migrations-dir migrations",
    "seed": "tsx seeds/run.ts",
    "images:recipes": "tsx seeds/scripts/upload-recipe-images.ts",
    "test:unit": "tsx --test seeds/scripts/*.test.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "node-pg-migrate": "^7.0.0",
    "pg": "^8.13.0",
    "sharp": "^0.35.1",
    "tsx": "^4.19.0"
  },
  "dependencies": {
    "@types/pg": "^8.11.0"
  }
}
