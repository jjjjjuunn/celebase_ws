# CelebBase — TLS termination + reverse proxy.
# CHORE-MOBILE-STAGING-BFF-001 Phase B.
# CHORE-WEB-APEX-DOMAIN-001: serves TWO sites from this one box —
#   1. {$STAGING_DOMAIN} (e.g. staging.celebase.app) — full app + mobile BFF gateway.
#   2. celebase.app (prod apex) — public landing + legal pages ONLY (BFF / frozen
#      web product are 404'd here; mobile uses staging.celebase.app as its API base).
#
# Caddy reads {$STAGING_DOMAIN} from container env (set by compose).
# Cert storage: /data/caddy/certificates/<issuer>/<domain>/ — persisted to
# caddy_data named volume so restarts/redeploys do not re-issue.
#
# ─────────────────────────────────────────────────────────────────────────
# Initial dry-run (rate-limit safe — LE staging CA has 30k cert/week limit)
# ─────────────────────────────────────────────────────────────────────────
# 1. Uncomment the `acme_ca` line in the global block below.
# 2. docker compose up -d caddy && docker compose logs -f caddy
#    Wait for "certificate obtained successfully".
# 3. curl -k https://<STAGING_DOMAIN>/api/health   # 200 (`-k` ignores staging CA)
# 4. Switch to prod CA — DELETE staging issuer dir ONLY (preserve prod if any):
#       docker compose exec caddy ls /data/caddy/certificates/
#       docker compose exec caddy rm -rf \
#         /data/caddy/certificates/acme-staging-v02.api.letsencrypt.org-directory
# 5. Re-comment the `acme_ca` line.
# 6. docker compose restart caddy
#    Caddy will request a fresh cert from prod LE CA (rate-limit safe — first
#    issuance for this domain).
# 7. openssl s_client -connect <STAGING_DOMAIN>:443 -servername <STAGING_DOMAIN> \
#      < /dev/null 2>&1 | grep "issuer="
#    Confirm: issuer=...Let's Encrypt...
# ─────────────────────────────────────────────────────────────────────────
{
	# Uncomment for initial LE staging CA dry-run; re-comment + restart for prod CA.
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

{$STAGING_DOMAIN} {
	# spec.md §4.2 hybrid BFF: mobile calls /auth/refresh directly against
	# user-service (BFF /api/auth/refresh is cookie-shaped, not bearer).
	# Route the user-service direct path through Caddy so user-service stays
	# off the public internet (SG keeps 3001-3005 closed).
	@user_direct path /auth/refresh
	reverse_proxy @user_direct user-service:3001

	# Everything else → BFF (apps/web). Includes /api/* (regular BFF routes)
	# plus SSR pages that may still be served from apps/web.
	reverse_proxy web:3000

	encode gzip

	log {
		output stdout
		format console
	}
}

# ── Production apex — public landing + legal ONLY (CHORE-WEB-APEX-DOMAIN-001) ──
# Shares the same `web` container as the staging block above, but scopes the
# public surface to the marketing landing (/) + legal pages (/terms, /privacy).
# The mobile BFF (/api/*, /auth/refresh) and the frozen web product routes are
# 404'd here — no client needs them on the apex (mobile's EXPO_PUBLIC_BFF_BASE_URL
# points at staging.celebase.app). Removing them keeps staging BE/data off the
# public prod domain and kills the dead web Hosted-UI login path (/login).
#
# Cloudflare: the celebase.app A record MUST be "DNS only" (grey cloud) so Caddy's
# Let's Encrypt HTTP-01 / TLS-ALPN-01 challenge reaches this origin directly.
# Add the A record (→ this box) BEFORE deploying, or the first cert issuance
# loops until DNS resolves.
celebase.app {
	# Block BFF + frozen app/auth/onboarding/slice routes; landing static assets
	# (/_next/*, /cardnews/*, favicon) and /terms, /privacy fall through to web.
	@blocked path /api/* /auth/refresh /login /login/* /signup /signup/* /home /home/* /dashboard /dashboard/* /celebrities /celebrities/* /recipes /recipes/* /plans /plans/* /track /track/* /account /account/* /onboarding /onboarding/* /slice /slice/*
	respond @blocked 404

	reverse_proxy web:3000

	encode gzip

	log {
		output stdout
		format console
	}
}
